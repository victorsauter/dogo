{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "A_REMPLIR_ADRESSE_DU_COMPTE_APPLE_DEVELOPER",
        "appleTeamId": "A_REMPLIR_IDENTIFIANT_D_EQUIPE_APPLE",
        "ascAppId": "A_REMPLIR_ID_APPLE_DE_L_APP_DANS_APP_STORE_CONNECT"
      }
    },
    "production": {
      "ios": {
        "appleId": "A_REMPLIR_ADRESSE_DU_COMPTE_APPLE_DEVELOPER",
        "appleTeamId": "A_REMPLIR_IDENTIFIANT_D_EQUIPE_APPLE",
        "ascAppId": "A_REMPLIR_ID_APPLE_DE_L_APP_DANS_APP_STORE_CONNECT"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "closed-test": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
