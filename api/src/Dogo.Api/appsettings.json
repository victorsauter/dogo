{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Dogo": ""
  },
  "Auth": {
    "AllowDevLogin": false,
    "Jwt": {
      "Issuer": "dogo-api",
      "Audience": "dogo-app"
    },
    "Apple": {
      "Audiences": []
    },
    "Google": {
      "Audiences": []
    }
  },
  "Admin": {
    "Emails": [],
    "ReportEmail": ""
  },
  "Storage": {
    "Local": {
      "Path": "./data/photos"
    }
  },
  "Notifications": {
    "Provider": "Log",
    "Expo": {
      "AccessToken": ""
    }
  },
  "DemoData": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitLimit": 60, "Window": "00:01:00" },
    "Writes": { "PermitLimit": 60, "Window": "00:01:00" },
    "SensitiveWrites": { "PermitLimit": 30, "Window": "00:10:00" }
  },
  "Proxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "BackgroundJobs": {
    "Enabled": true,
    "Interval": "00:01:00"
  }
}
