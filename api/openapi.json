  "components": {
    "schemas": {
      "AppleSignInRequest": {
        "required": [
          "identityToken"
        ],
        "type": "object",
        "properties": {
          "identityToken": {
            "type": "string"
          },
          "displayName": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateDogRequest": {
        "required": [
          "name",
          "size",
          "sociability",
          "reactivity",
          "leashHabit"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "size": {
            "$ref": "#/components/schemas/DogSize"
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "breed": {
            "maxLength": 80,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "sociability": {
            "$ref": "#/components/schemas/Sociability"
          },
          "reactivity": {
            "$ref": "#/components/schemas/Reactivity"
          },
          "leashHabit": {
            "$ref": "#/components/schemas/LeashHabit"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DevSignInRequest": {
        "required": [
          "subject",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "displayName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "DogResponse": {
        "required": [
          "id",
          "ownerId",
          "name",
          "photoUrl",
          "size",
          "birthDate",
          "breed",
          "sociability",
          "reactivity",
          "leashHabit",
          "description",
