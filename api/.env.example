# Variables d'environnement de l'API hors développement (copier en .env, jamais versionné).
# En développement, appsettings.Development.json fournit déjà des valeurs locales.
# Les tableaux se règlent avec un index : Section__Cle__0, Section__Cle__1...

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5080

# Base PostgreSQL avec PostGIS
ConnectionStrings__Dogo=Host=localhost;Port=5432;Database=dogo;Username=dogo;Password=change-me

# Clé de signature des jetons d'accès (HMAC-SHA256, 32 octets au moins). Obligatoire.
# Générer par exemple avec : openssl rand -base64 48
Auth__Jwt__SigningKey=

# Connexion de test : interdite en Production (l'API refuse de démarrer).
Auth__AllowDevLogin=false

# Audiences acceptées dans les jetons d'identité
Auth__Apple__Audiences__0=com.victorsauter.dogo
Auth__Google__Audiences__0=
# Auth__Google__Audiences__1=

# Administrateurs (e-mails vérifiés par Apple ou Google)
Admin__Emails__0=
# Adresse prévenue de chaque signalement (pas encore utilisée : aucun fournisseur d'e-mails, journal seulement)
Admin__ReportEmail=

# Dossier des photos (relatif au dossier de l'application s'il n'est pas absolu)
Storage__Local__Path=./data/photos

# Notifications push : Log (journal seulement, par défaut) ou Expo (envoi réel)
Notifications__Provider=Expo
# Seulement si la sécurité renforcée des notifications est activée dans le projet Expo
Notifications__Expo__AccessToken=

# Tâches planifiées (rappels, séries hebdomadaires)
BackgroundJobs__Enabled=true
BackgroundJobs__Interval=00:01:00
