# Variables d'environnement de l'API hors développement (copier en .env, jamais versionné).
# En développement, appsettings.Development.json fournit déjà des valeurs locales.
# Les tableaux se règlent avec un index : Section__Cle__0, Section__Cle__1...

ASPNETCORE_ENVIRONMENT=Production
# Hors conteneur seulement. L'image Docker écoute déjà sur le port 8080 (ASPNETCORE_HTTP_PORTS) ; ne pas
# poser ASPNETCORE_URLS avec l'image : il l'emporte, et le contrôle de santé de l'image ne le suivrait pas.
# ASPNETCORE_URLS=http://+:5080
# Nom public de l'API (plusieurs noms séparés par ;). Une requête avec un autre Host reçoit 400.
AllowedHosts=api.example.com

# Base PostgreSQL avec PostGIS
ConnectionStrings__Dogo=Host=localhost;Port=5432;Database=dogo;Username=dogo;Password=change-me

# Clé de signature des jetons d'accès (HMAC-SHA256, 32 octets au moins). Obligatoire.
# Générer par exemple avec : openssl rand -base64 48
# La clé de appsettings.Development.json est refusée hors Development.
Auth__Jwt__SigningKey=
# Rejeu accepté d'un jeton de rafraîchissement remplacé (0 à 5 minutes) et conservation avant purge (ADR 0035)
Auth__Jwt__RefreshTokenGracePeriod=00:01:00
Auth__Jwt__RefreshTokenRetention=30.00:00:00

# Connexion de test et données de démonstration : admises seulement en Development et Testing ;
# dans tout autre environnement, l'API refuse de démarrer si l'une est vraie.
Auth__AllowDevLogin=false
DemoData__Enabled=false

# Audiences acceptées dans les jetons d'identité (en Production, au moins une, Apple ou Google)
Auth__Apple__Audiences__0=com.victorsauter.uzu
Auth__Google__Audiences__0=
# Auth__Google__Audiences__1=

# Administrateurs (e-mails vérifiés par Apple ou Google)
Admin__Emails__0=
# Adresse prévenue de chaque signalement (pas encore utilisée : aucun fournisseur d'e-mails ;
# les signalements sont journalisés et notifiés par push aux administrateurs)
Admin__ReportEmail=

# Dossier des photos (relatif au dossier de l'application s'il n'est pas absolu)
Storage__Local__Path=./data/photos
# Nettoyage des photos (valeurs par défaut ; ADR 0032). Hors plage : ramené dans la plage ; illisible : démarrage refusé
Photos__MaxPixels=25000000
Photos__MaxSide=2048
Photos__JpegQuality=90
Photos__WebpQuality=85

# Notifications push : Log (journal seulement, par défaut ; refusé en Production) ou Expo (envoi réel)
Notifications__Provider=Expo
# Seulement si la sécurité renforcée des notifications est activée dans le projet Expo
Notifications__Expo__AccessToken=

# Limitation de débit (valeurs par défaut ; fenêtre au format hh:mm:ss)
RateLimiting__Enabled=true
RateLimiting__Auth__PermitLimit=60
RateLimiting__Auth__Window=00:01:00
RateLimiting__Writes__PermitLimit=60
RateLimiting__Writes__Window=00:01:00
RateLimiting__SensitiveWrites__PermitLimit=30
RateLimiting__SensitiveWrites__Window=00:10:00

# Proxy inverse : X-Forwarded-For et X-Forwarded-Proto ne sont lus que s'il est activé, et seulement
# depuis ces adresses ou réseaux (et la boucle locale). Ne pas utiliser ASPNETCORE_FORWARDEDHEADERS_ENABLED.
Proxy__Enabled=false
# Proxy__KnownProxies__0=10.0.0.2
# Proxy__KnownNetworks__0=10.0.0.0/24
Proxy__ForwardLimit=1

# Tâches planifiées (rappels, séries hebdomadaires, purge des jetons) et durée maximale d'un passage
BackgroundJobs__Enabled=true
BackgroundJobs__Interval=00:01:00
BackgroundJobs__PurgeInterval=01:00:00
BackgroundJobs__JobTimeout=00:02:00
